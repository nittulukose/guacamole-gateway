# ---- LDAP ----
LDAP_DOMAIN=hcltech.com
LDAP_ORG=HCLTECH Inc
LDAP_ADMIN_PASSWORD=LdapAdmin123!
LDAP_CONFIG_PASSWORD=LdapConfig123!

# ---- Guacamole DB (authorization store: connections, groups, permissions) ----
POSTGRES_DB=guacamole_db
POSTGRES_USER=guacamole_user
POSTGRES_PASSWORD=GuacDbPass123!

# ---- NPA (Non-Personal Account) credentials used by Guacamole to log
#      into the target machines. These are NOT the end users' own
#      LDAP passwords - Bob and Alice never see or use these. ----
NPA_SSH_USERNAME=npa-svc
NPA_SSH_PASSWORD=NpaPass123!
NPA_RDP_USERNAME=npa-desktop
NPA_RDP_PASSWORD=NpaPass123!

# ---- Demo LDAP user passwords (for logging into the Guacamole portal) ----
BOB_PASSWORD=BobPass123!
ALICE_PASSWORD=AlicePass123!
GUACADMIN_PASSWORD=GuacAdminPass123!
